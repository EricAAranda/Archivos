				{
					"name": "Asignar grupos o usuarios a una tarea",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const loginUrl = \"https://keycloak-auth-desa.bancontinental.com.py/realms/jbpm_realm/protocol/openid-connect/token\";\r",
									"const username = 'administrator';\r",
									"const password = 'a.123456'\r",
									"pm.sendRequest({\r",
									"    url: loginUrl,\r",
									"    method: 'POST',\r",
									"    header: {\r",
									"        'content-type': 'application/x-www-form-urlencoded',\r",
									"    },\r",
									"    body : {\r",
									"        mode: 'urlencoded',\r",
									"        urlencoded: [\r",
									"            { key: 'grant_type', value: 'password' },\r",
									"            { key: 'client_id', value: 'jbpm-client' },\r",
									"            { key: 'client_secret', value: 'fGbm7ClSzX9oQTU0loqkEMaD14NB2jYi' },\r",
									"            { key: 'scope', value: 'openid' },\r",
									"            { key: 'username', value: username },\r",
									"            { key: 'password', value: password }\r",
									"        ]\r",
									"    }\r",
									"}, function (err, res) {\r",
									"    pm.environment.set(\"auth\",  res.json().access_token);\r",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "default"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"users\" : [\"rafael.recoder\"],\r\n    \"groups\" : []\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
